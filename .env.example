# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# DeskTime
DESKTIME_API_KEY=

# Resend (email)
RESEND_API_KEY=

# Payslips sent from the payroll site (payroll-ortus.vercel.app). The secret is
# pasted into the payroll site's settings by an HR admin; rotate it if lost.
PAYSLIP_IMPORT_SECRET=
# Comma-separated origins allowed to call /api/payslips/import from a browser.
PAYSLIP_IMPORT_ORIGINS=https://payroll-ortus.vercel.app

# Cron secret (to secure cron endpoints)
CRON_SECRET=

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
